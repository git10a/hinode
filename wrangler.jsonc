{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hinode-migration-preview",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "cache": {
    "enabled": true
  },
  // 記事CMS（docs/cms.md）。記事は D1、画像は R2 に置く
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hinode-cms",
      "database_id": "d7f3e17d-fdca-44ea-b702-467df9d8abdd",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "hinode-media"
    }
  ]
}
