{
  "name": "hinode",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib next.config.js vite.config.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@vinext/cloudflare": "^1.0.0-beta.9",
    "microcms-js-sdk": "^3.1.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-server-dom-webpack": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.57.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "vinext": "^1.0.0-beta.11",
    "vite": "^8.3.0",
    "wrangler": "^4.136.3"
  },
  "type": "module"
}
